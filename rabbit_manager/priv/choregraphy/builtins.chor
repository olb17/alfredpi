[{
	"name": "Initialisation",
	"code": "SYSTEM_STARTUP_CHOREGRAPHY",
	"actions": "var Delay = 150\nvar Color = ~e5a50a\n\nled_color ~000000, Led0\nrepeat 5 \n     led_color Color, Led1\n     led_color Color, Led2\n     led_color Color, Led3\n     led_color Color, Led4\n     sleep Delay\n     led_color ~000000, Led0\n     led_color ~000000, Led1\n     led_color ~000000, Led2\n     led_color ~000000, Led3\n     led_color ~000000, Led4\n     sleep Delay\nend\nled_color ~0000FF, Led0"
},
{
	"name": "Nose led to blue",
	"code": "SYSTEM_BLUE",
	"actions": "led_color ~3d34eb, Led0"
},
{
	"name": "Cylon mode",
	"code": "SYSTEM_CYLON",
	"actions": "var Delay = 200\nvar Red = ~ff0000\nvar Redish = ~ffbf00\nvar Black = ~000000\nrepeat 5\n     led_color Red, Led1\n     sleep Delay\n     led_color Redish, Led1\n     led_color Red, Led2\n     sleep Delay\n     led_color Black, Led1\n     led_color Redish, Led2\n     led_color Red, Led3\n     sleep Delay\n     led_color Black, Led2\n     sleep Delay\n     sleep Delay\n     led_color Redish, Led3\n     led_color Red, Led2\n     sleep Delay\n     led_color Black, Led3\n     led_color Redish, Led2\n     led_color Red, Led1\n     sleep Delay\n     led_color Black, Led2\n     sleep Delay\nend\nled_color Black, Led1\nled_color Black, Led2\nled_color Black, Led3\nled_color ~0000ff, Led0\n"
},
